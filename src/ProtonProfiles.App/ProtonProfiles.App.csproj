<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProtonProfiles.App</RootNamespace>
    <AssemblyName>SecureBrowser</AssemblyName>
    <Product>SecureBrowser</Product>
    <AssemblyTitle>SecureBrowser</AssemblyTitle>
    <Description>SecureBrowser</Description>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <!-- Pin patched runtime packs for self-contained releases. -->
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <!-- Allows compile-only verification from non-Windows CI. It does NOT verify runtime behavior. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\globe.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- dotnet build -p:ExperimentalProxy=true produces the explicitly experimental WebView2 proxy build (spec §2). -->
  <PropertyGroup Condition="'$(ExperimentalProxy)' == 'true'">
    <DefineConstants>$(DefineConstants);EXPERIMENTAL_PROXY</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEV_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Diagnostics\fingerprint.html" LogicalName="ProtonProfiles.App.Diagnostics.fingerprint.html" />
    <EmbeddedResource Include="Diagnostics\context.html" LogicalName="ProtonProfiles.App.Diagnostics.context.html" />
    <EmbeddedResource Include="Diagnostics\context-observation.v1.js" LogicalName="ProtonProfiles.App.Diagnostics.context-observation.v1.js" />
    <Resource Include="Assets\globe.ico" />
    <Resource Include="Assets\globe.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProtonProfiles.Core\ProtonProfiles.Core.csproj" />
  </ItemGroup>
</Project>
