<Window x:Class="ProtonProfiles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proton Profiles" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Profile directory -->
        <DockPanel Grid.Column="0" Margin="10">
            <TextBlock DockPanel.Dock="Top" Text="Профили" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox DockPanel.Dock="Top" x:Name="SearchBox" TextChanged="OnSearchChanged"
                     ToolTip="Поиск по названию и метке" AutomationProperties.Name="Поиск профилей" Margin="0,0,0,6" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Создать" Click="OnCreate" Margin="0,0,6,6" />
                <Button Content="Импорт…" Click="OnImport" Margin="0,0,6,6" />
                <Button Content="Экспорт…" Click="OnExport" Margin="0,0,6,6" />
                <Button Content="Диагностика…" Click="OnDiagnostics" Margin="0,0,6,6" />
            </WrapPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="▲" ToolTip="Выше" Click="OnMoveUp" />
                <Button Content="▼" ToolTip="Ниже" Click="OnMoveDown" />
                <Button Content="★" ToolTip="Избранное" Click="OnToggleFavorite" />
                <Button Content="📌" ToolTip="Закрепить (не предлагать к закрытию)" Click="OnTogglePinned" />
            </StackPanel>
            <ListBox x:Name="ProfileList" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnListDoubleClick"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Список профилей"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EmailLabel}" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReminderText}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReminderDue}" Value="True">
                                                    <Setter Property="Foreground" Value="DarkOrange" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="{Binding PinMark}" Margin="4,0,0,0" />
                                <TextBlock Text="{Binding FavoriteMark}" Foreground="Goldenrod" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#22000000" />

        <!-- Selected profile -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" x:Name="ExperimentalBanner" Background="#FFF3CD" Padding="10,6" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap"
                           Text="Экспериментальная сборка: прокси задаётся недокументированным флагом браузера (--proxy-server). Это не гарантирует сетевую изоляцию. Не используйте с реальными аккаунтами, пока сетевые проверки не пройдены." />
            </Border>
            <Border DockPanel.Dock="Top" BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="10,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Vertical" MinWidth="220">
                        <TextBlock x:Name="SelectedName" Text="Профиль не выбран" FontSize="18" FontWeight="SemiBold"
                                   ToolTip="Локальная метка профиля, а не подтверждение аккаунта, в который выполнен вход" />
                        <TextBlock x:Name="SelectedStatus" Foreground="Gray" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="OpenButton" Content="Открыть" Click="OnOpenClose" Margin="0,2,6,2" />
                        <Button Content="Перезапустить" Click="OnRestart" Margin="0,2,6,2" />
                        <Button Content="Повторить восстановление" x:Name="RecoveryButton" Click="OnRetryRecovery" Visibility="Collapsed" Margin="0,2,6,2" />
                        <Button Content="Я проверил ящик" Click="OnConfirmVisit" Margin="0,2,6,2"
                                ToolTip="Отметить, что вы вручную проверили этот почтовый ящик" />
                        <Button Content="Напоминания…" Click="OnReminderMenu" Margin="0,2,6,2" />
                        <Button Content="Настройки…" Click="OnSettings" Margin="0,2,6,2" />
                        <Button Content="Сбросить сессию…" Click="OnReset" Margin="0,2,6,2" />
                        <Button Content="Удалить…" Click="OnDelete" Margin="0,2,6,2" />
                    </WrapPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" x:Name="ExternalLinkBar" Background="#E8F0FE" Padding="10,6" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Скрыть" Click="OnDismissExternal" />
                    <Button DockPanel.Dock="Right" Content="Открыть во внешнем браузере" Click="OnOpenExternal" />
                    <StackPanel>
                        <TextBlock x:Name="ExternalLinkText" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ExternalLinkNote" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                                   Text="Внешний браузер использует собственную сессию и свои сетевые настройки." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="#22000000" BorderThickness="0,1,0,0" Padding="10,4">
                <TextBlock x:Name="StatusBarText" Foreground="Gray" TextTrimming="CharacterEllipsis" />
            </Border>
            <Grid x:Name="BrowserArea">
                <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" TextAlignment="Center"
                           Text="Выберите профиль и нажмите «Открыть».&#x0a;Вход, двухфакторная аутентификация и проверки Proton выполняются на страницах самого сервиса." />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
